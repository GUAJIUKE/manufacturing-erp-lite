# Manufacturing ERP Lite — environment template
# Copy to .env at the repository root for docker compose:  cp .env.example .env
# Anything you leave blank will fall back to a demo-only default; production
# deployments MUST override SECRET_KEY and DB_PASSWORD.

# ----- MySQL container -----
DB_PASSWORD=erp_lite_dev           # demo-only; change in production
DB_NAME=erp_lite                    # business database (not the *_test one)

# ----- Backend / JWT -----
SECRET_KEY=erp-lite-demo-secret-change-me-in-production
# Real example:  openssl rand -hex 32

# ----- Demo data seeding -----
# 1 = run seed_demo on container start (idempotent, resets business story)
# 0 = skip; production deployments should leave this OFF
DEMO_SEED=1

# ----- npm registry (optional, used by frontend Docker build) -----
# NPM_REGISTRY=https://registry.npmmirror.com